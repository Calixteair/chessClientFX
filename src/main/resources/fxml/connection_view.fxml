<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      styleClass="screen" alignment="CENTER_LEFT" spacing="14" prefWidth="760" prefHeight="640">
    <padding><Insets top="48" right="96" bottom="48" left="96"/></padding>
    <Label text="PARTIE À DEUX, EN LIGNE" styleClass="eyebrow"/>
    <Label text="Prenez place." styleClass="title-xl"/>
    <Label wrapText="true" styleClass="lede" maxWidth="440"
           text="Choisissez un pseudo pour entrer dans le salon. Votre adversaire peut jouer depuis ce client ou depuis le navigateur."/>
    <Label text="Pseudo" styleClass="field-label">
        <VBox.margin><Insets top="18"/></VBox.margin>
    </Label>
    <TextField fx:id="usernameField" maxWidth="360" onAction="#handleConnectButton"/>
    <Label text="1 à 20 caractères : lettres, chiffres, _ et -" styleClass="hint"/>
    <Button fx:id="connectButton" text="Entrer dans le salon" styleClass="primary" defaultButton="true"
            onAction="#handleConnectButton"/>
    <Label fx:id="errorLabel" styleClass="error" wrapText="true"/>
</VBox>
