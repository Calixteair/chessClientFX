<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      styleClass="screen" spacing="40" prefWidth="1000" prefHeight="700">
    <padding><Insets top="28" right="40" bottom="28" left="40"/></padding>

    <VBox spacing="10">
        <Label fx:id="opponentLabel" styleClass="player"/>
        <StackPane fx:id="boardHolder" styleClass="board-frame"/>
        <Label fx:id="meLabel" styleClass="player"/>
    </VBox>

    <VBox spacing="16" HBox.hgrow="ALWAYS" minWidth="280">
        <Label text="PARTIE" styleClass="eyebrow"/>
        <Label fx:id="titleLabel" styleClass="title-md" wrapText="true"/>
        <VBox spacing="4" styleClass="status-box">
            <Label fx:id="statusLabel" styleClass="status"/>
            <Label fx:id="detailLabel" styleClass="hint" wrapText="true"/>
        </VBox>
        <ListView fx:id="historyList" styleClass="sheet" VBox.vgrow="ALWAYS"/>
        <HBox spacing="8">
            <Button fx:id="resignButton" text="Abandonner" styleClass="quiet" onAction="#handleResignButton"/>
            <Button fx:id="backButton" text="Retour au salon" styleClass="primary" onAction="#handleBackButton"/>
        </HBox>
    </VBox>
</HBox>
